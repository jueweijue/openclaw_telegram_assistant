[Unit]
Description=OpenClaw Telegram Assistant
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/project/openclaw_telegram_assistant
EnvironmentFile=/root/project/openclaw_telegram_assistant/.env
ExecStart=/usr/bin/python3 /root/project/openclaw_telegram_assistant/bot.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
