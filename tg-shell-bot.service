[Unit]
Description=Telegram Shell Bot
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/project/tg-shell-bot
EnvironmentFile=/root/project/tg-shell-bot/.env
ExecStart=/usr/bin/python3 /root/project/tg-shell-bot/bot.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
